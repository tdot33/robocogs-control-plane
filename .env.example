# Turso Database
TURSO_URL=libsql://[db-name]-[org].turso.io
TURSO_AUTH_TOKEN=eyJ...

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Ingress bridge mode (public bridge -> private backend)
# Leave WEBHOOK_FORWARD_URL empty in normal backend mode.
WEBHOOK_FORWARD_URL=
# Set to "oidc" for Cloud Run service-to-service forwarding.
WEBHOOK_FORWARD_AUTH_MODE=none
# Optional explicit audience for OIDC token minting.
WEBHOOK_FORWARD_AUDIENCE=

# Inngest (leave blank for local dev — Inngest Dev Server handles it)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Shared secret for upstream work:start intake from main robocogs repo
ORCHESTRATION_SHARED_SECRET=

# App
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# Dashboard auth gate
ADMIN_UI_USERNAME=admin
ADMIN_UI_PASSWORD=change-me
ADMIN_UI_SESSION_SECRET=replace-with-long-random-secret
